{
	"name": "pier",
	"version": "0.2.34",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"typecheck": "tsc -b",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"host": "tsx packages/host/src/main.ts",
		"pier-cli": "tsx packages/client/src/cli.ts",
		"faux-host": "tsx packages/host/scripts/faux-host.ts",
		"desktop": "bun run --cwd apps/desktop dev",
		"build:sidecar": "node packages/host/scripts/build-sidecar.mjs",
		"relay": "tsx apps/relay/src/main.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/node": "^26.6.3",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.2"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	]
}
